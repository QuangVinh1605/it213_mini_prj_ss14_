# ==================================================
# SmartHub - Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# KHÔNG COMMIT FILE .env VÀO GIT!
# ==================================================

# === DATABASE (PostgreSQL + Pgvector) ===
# [CẦN ĐIỀN] Password cho PostgreSQL database
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# [TÙY CHỌN] Tên database (mặc định: smarthub)
DATABASE_NAME=smarthub

# [TÙY CHỌN] Username database (mặc định: smarthub)
DATABASE_USERNAME=smarthub

# [TÙY CHỌN] Host database (mặc định: localhost)
DATABASE_HOST=localhost

# [TÙY CHỌN] Port database (mặc định: 5432)
DATABASE_PORT=5432

# === OPENAI API ===
# [CẦN ĐIỀN] API key cho OpenAI (dùng cho Embedding + Chat LLM)
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# [TÙY CHỌN] Model LLM cho chat (mặc định: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# [TÙY CHỌN] Model Embedding (mặc định: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === LLMOPS / LANGFUSE ===
# [TÙY CHỌN] Bật/tắt phân hệ LLMOps
LLMOPS_ENABLED=true

# [TÙY CHỌN] Gửi prompt/completion vào trace. Tắt nếu dữ liệu nhạy cảm.
LLMOPS_CAPTURE_PAYLOADS=true
LLMOPS_MAX_PAYLOAD_CHARS=4000

# [TÙY CHỌN] Infinite loop guard theo từng domain + conversation/session
LLMOPS_GUARD_ENABLED=true
LLMOPS_GUARD_MAX_CALLS_PER_WINDOW=8
LLMOPS_GUARD_WINDOW_SECONDS=60

# [TÙY CHỌN] Ước lượng token/cost khi provider không trả usage trực tiếp
LLMOPS_ESTIMATED_CHARS_PER_TOKEN=4
LLMOPS_INPUT_USD_PER_1K_TOKENS=0.00015
LLMOPS_OUTPUT_USD_PER_1K_TOKENS=0.0006

# [TÙY CHỌN] Langfuse OTLP endpoint. Tạo AUTH_STRING bằng:
# macOS/Linux: echo -n "pk-lf-...:sk-lf-..." | base64
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_PUBLIC_SECRET_KEY,x-langfuse-ingestion-version=4

# === RAG CONFIGURATION ===
# [TÙY CHỌN] Chunk size cho document ingestion (mặc định: 500)
RAG_CHUNK_SIZE=500

# [TÙY CHỌN] Chunk overlap percentage (mặc định: 10)
RAG_CHUNK_OVERLAP_PERCENT=10

# [TÙY CHỌN] Similarity threshold cho vector search (mặc định: 0.7)
RAG_SIMILARITY_THRESHOLD=0.7

# [TÙY CHỌN] Top-K results cho similarity search (mặc định: 5)
RAG_TOP_K=5
